<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- VLAP monochrome palette. Accent* keys survive so the existing styles keep working,
         but they now mean "the opposite of the background": white on dark, black on light. -->

    <SolidColorBrush x:Key="FgBrush" Color="#ECEEF3"/>
    <SolidColorBrush x:Key="MutedBrush" Color="#949BAA"/>
    <SolidColorBrush x:Key="DimBrush" Color="#6B7280"/>

    <SolidColorBrush x:Key="LineBrush" Color="#16FFFFFF"/>
    <SolidColorBrush x:Key="LineStrongBrush" Color="#29FFFFFF"/>
    <SolidColorBrush x:Key="RowLineBrush" Color="#0DFFFFFF"/>
    <SolidColorBrush x:Key="ShellBorderBrush" Color="#12FFFFFF"/>

    <SolidColorBrush x:Key="SurfaceBrush" Color="#0BFFFFFF"/>
    <SolidColorBrush x:Key="Surface2Brush" Color="#13FFFFFF"/>
    <SolidColorBrush x:Key="FieldBrush" Color="#0AFFFFFF"/>
    <SolidColorBrush x:Key="FieldFocusBrush" Color="#0FFFFFFF"/>
    <SolidColorBrush x:Key="IconBoxBrush" Color="#0EFFFFFF"/>
    <SolidColorBrush x:Key="MonoTextBrush" Color="#C8CEDB"/>
    <SolidColorBrush x:Key="ScrollThumbBrush" Color="#24FFFFFF"/>

    <SolidColorBrush x:Key="BodyBgBrush" Color="#FF14171C"/>
    <!-- 1/255 alpha: invisible, but keeps the whole layered window clickable instead of click-through -->
    <SolidColorBrush x:Key="AcrylicHitBrush" Color="#01000000"/>
    <SolidColorBrush x:Key="SettingsBgBrush" Color="#FC0C0E12"/>
    <SolidColorBrush x:Key="PopupBrush" Color="#F216191F"/>
    <SolidColorBrush x:Key="ToastBrush" Color="#F214171D"/>
    <SolidColorBrush x:Key="DialogBgBrush" Color="#FC14171C"/>
    <SolidColorBrush x:Key="DialogBorderBrush" Color="#22FFFFFF"/>

    <SolidColorBrush x:Key="KnobBrush" Color="#AAB1BF"/>

    <!-- inversion: used by selected tiles, checked toggles, active tabs -->
    <SolidColorBrush x:Key="InvertBgBrush" Color="#ECEEF3"/>
    <SolidColorBrush x:Key="InvertFgBrush" Color="#0E1014"/>

    <!-- legacy accent keys, now monochrome -->
    <SolidColorBrush x:Key="AccentBrush" Color="#ECEEF3"/>
    <SolidColorBrush x:Key="AccentSoftBrush" Color="#1FECEEF3"/>
    <SolidColorBrush x:Key="AccentLineBrush" Color="#66ECEEF3"/>

    <SolidColorBrush x:Key="GoodBrush" Color="#ECEEF3"/>
    <SolidColorBrush x:Key="DangerBrush" Color="#FF7D7D"/>
    <SolidColorBrush x:Key="DangerTextBrush" Color="#FF9E9E"/>
    <SolidColorBrush x:Key="DangerBgBrush" Color="#1AFF7D7D"/>

</ResourceDictionary>
