<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Light monochrome palette: the same keys as Dark.xaml, flipped. -->

    <SolidColorBrush x:Key="FgBrush" Color="#121316"/>
    <SolidColorBrush x:Key="MutedBrush" Color="#5B6069"/>
    <SolidColorBrush x:Key="DimBrush" Color="#8A8F99"/>

    <SolidColorBrush x:Key="LineBrush" Color="#14000000"/>
    <SolidColorBrush x:Key="LineStrongBrush" Color="#29000000"/>
    <SolidColorBrush x:Key="RowLineBrush" Color="#0D000000"/>
    <SolidColorBrush x:Key="ShellBorderBrush" Color="#1A000000"/>

    <SolidColorBrush x:Key="SurfaceBrush" Color="#08000000"/>
    <SolidColorBrush x:Key="Surface2Brush" Color="#12000000"/>
    <SolidColorBrush x:Key="FieldBrush" Color="#08000000"/>
    <SolidColorBrush x:Key="FieldFocusBrush" Color="#12000000"/>
    <SolidColorBrush x:Key="IconBoxBrush" Color="#0A000000"/>
    <SolidColorBrush x:Key="MonoTextBrush" Color="#4C5158"/>
    <SolidColorBrush x:Key="ScrollThumbBrush" Color="#33000000"/>

    <SolidColorBrush x:Key="BodyBgBrush" Color="#FFF6F6F8"/>
    <!-- 1/255 alpha: invisible, but keeps the whole layered window clickable instead of click-through -->
    <SolidColorBrush x:Key="AcrylicHitBrush" Color="#01FFFFFF"/>
    <SolidColorBrush x:Key="SettingsBgBrush" Color="#FFF9F9FB"/>
    <SolidColorBrush x:Key="PopupBrush" Color="#FFFFFFFF"/>
    <SolidColorBrush x:Key="ToastBrush" Color="#FFFFFFFF"/>
    <SolidColorBrush x:Key="DialogBgBrush" Color="#FFFFFFFF"/>
    <SolidColorBrush x:Key="DialogBorderBrush" Color="#22000000"/>

    <SolidColorBrush x:Key="KnobBrush" Color="#8A8F99"/>

    <SolidColorBrush x:Key="InvertBgBrush" Color="#121316"/>
    <SolidColorBrush x:Key="InvertFgBrush" Color="#FFFFFF"/>

    <SolidColorBrush x:Key="AccentBrush" Color="#121316"/>
    <SolidColorBrush x:Key="AccentSoftBrush" Color="#14121316"/>
    <SolidColorBrush x:Key="AccentLineBrush" Color="#55121316"/>

    <SolidColorBrush x:Key="GoodBrush" Color="#121316"/>
    <SolidColorBrush x:Key="DangerBrush" Color="#D64545"/>
    <SolidColorBrush x:Key="DangerTextBrush" Color="#C0392B"/>
    <SolidColorBrush x:Key="DangerBgBrush" Color="#1FD64545"/>

</ResourceDictionary>
