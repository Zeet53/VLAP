<Window x:Class="VLAP.PresetEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:VLAP"
        Title="Набор"
        Width="430" Height="540"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        FontFamily="Segoe UI Variable Text, Segoe UI"
        FontSize="13"
        TextOptions.TextRenderingMode="Grayscale"
        Foreground="{DynamicResource FgBrush}">

    <Window.Resources>
        <!-- brushes come from the application theme dictionary -->

        <Style x:Key="DialogBtn" TargetType="Button">
            <Setter Property="Height" Value="34"/>
            <Setter Property="Padding" Value="16,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="B" CornerRadius="8" BorderThickness="1"
                                BorderBrush="{DynamicResource LineBrush}" Background="{DynamicResource SurfaceBrush}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="B" Property="BorderBrush" Value="{DynamicResource LineStrongBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource FgBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryBtn" TargetType="Button" BasedOn="{StaticResource DialogBtn}">
            <Setter Property="Foreground" Value="{DynamicResource InvertFgBrush}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="B" CornerRadius="8" Background="{DynamicResource InvertBgBrush}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="B" Property="Opacity" Value="0.9"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ListBoxItem">
            <Setter Property="Margin" Value="0,0,0,2"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="B" CornerRadius="8" Padding="8,6" Background="Transparent"
                                BorderBrush="Transparent" BorderThickness="1">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border Width="24" Height="24" CornerRadius="6" Background="{DynamicResource IconBoxBrush}"
                                        BorderBrush="{DynamicResource LineBrush}" BorderThickness="1">
                                    <Grid>
                                        <Image Source="{Binding IconImage}" Width="15" Height="15"/>
                                        <TextBlock Text="{Binding Mono}" FontSize="9" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource MonoTextBrush}" HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding HasIcon}" Value="True">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Grid>
                                </Border>
                                <TextBlock Grid.Column="1" Text="{Binding Name}" Foreground="{DynamicResource MutedBrush}"
                                           VerticalAlignment="Center" Margin="9,0,0,0" TextTrimming="CharacterEllipsis"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="B" Property="Background" Value="{DynamicResource SurfaceBrush}"/>
                                <Setter TargetName="B" Property="BorderBrush" Value="{DynamicResource LineBrush}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="B" Property="Background" Value="{DynamicResource InvertBgBrush}"/>
                                <Setter TargetName="B" Property="BorderBrush" Value="{DynamicResource InvertBgBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Margin="16" CornerRadius="16" Background="{DynamicResource DialogBgBrush}" BorderBrush="{DynamicResource DialogBorderBrush}" BorderThickness="1"
            MouseLeftButtonDown="Root_MouseLeftButtonDown">
        <Border.Effect>
            <DropShadowEffect BlurRadius="30" ShadowDepth="6" Direction="270" Opacity="0.55" Color="Black"/>
        </Border.Effect>

        <Grid Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock x:Name="TitleText" Text="Новый набор" FontSize="15" FontWeight="SemiBold"
                       Foreground="{DynamicResource FgBrush}"/>

            <Border Grid.Row="1" Margin="0,14,0,0" CornerRadius="9" BorderThickness="1"
                    BorderBrush="{DynamicResource LineBrush}" Background="{DynamicResource FieldBrush}" Padding="11,0" Height="38">
                <TextBox x:Name="NameBox" Background="Transparent" BorderThickness="0"
                         Foreground="{DynamicResource FgBrush}" CaretBrush="{DynamicResource FgBrush}"
                         FontSize="13" VerticalContentAlignment="Center" MaxLength="40"/>
            </Border>

            <TextBlock Grid.Row="2" Text="Выбери приложения для набора" FontSize="11.5"
                       Foreground="{DynamicResource DimBrush}" Margin="0,14,0,8"/>

            <Border Grid.Row="3" CornerRadius="10" BorderThickness="1" BorderBrush="{DynamicResource LineBrush}"
                    Background="{DynamicResource SurfaceBrush}" Padding="4">
                <ListBox x:Name="AppsBox" Background="Transparent" BorderThickness="0"
                         SelectionMode="Multiple"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"/>
            </Border>

            <Grid Grid.Row="4" Margin="0,16,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="SelectionHint" Text="Выбрано: 0" FontSize="11.5"
                           Foreground="{DynamicResource DimBrush}" VerticalAlignment="Center"/>
                <Button Grid.Column="1" Content="Отмена" Style="{StaticResource DialogBtn}"
                        HorizontalAlignment="Right" Margin="0,0,8,0" Click="Cancel_Click"/>
                <Button Grid.Column="2" Content="Сохранить" Style="{StaticResource PrimaryBtn}" Click="Save_Click"/>
            </Grid>
        </Grid>
    </Border>
</Window>
